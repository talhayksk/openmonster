post_install() {
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
  systemctl daemon-reload >/dev/null 2>&1 || true
  cat <<'EOF'
OpenMonster kuruldu.

  Uygulama menusunden "OpenMonster" ile acabilirsiniz.
  Root islemleri icin uygulama acilirken bir kez sifre sorulur.
  Fan profil servisi (istege bagli): sudo systemctl enable --now monster-ctrl-fanprofile
  Kaldirma: sudo pacman -R openmonster
EOF
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable --now monster-ctrl-fanprofile.service >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true
}

post_remove() {
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
}
